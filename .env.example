# ==============================================================================
# ULPF — Universal Log Pre-processing Framework (SIH26156 / NTRO)
# Environment Configuration Template
# ==============================================================================

# Operational Mode
ULPF_ENV=production
ULPF_DEMO_MODE=false
ULPF_SECRET_KEY=replace-with-a-very-secure-32-byte-secret-key-for-jwt-signing
ULPF_JWT_ALGORITHM=HS256
ULPF_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ULPF_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Storage Sinks & Backend Selection
# Options: 'minio' (Production Object Storage) or 'local' (Development Disk Blob)
ULPF_STORAGE_BACKEND=minio
ULPF_MINIO_ENDPOINT=minio:9000
ULPF_MINIO_ACCESS_KEY=minioadmin
ULPF_MINIO_SECRET_KEY=minioadmin123
ULPF_MINIO_RAW_BUCKET=ulpf-raw
ULPF_MINIO_SECURE=false

# Search Store Backend Selection
# Options: 'opensearch' (Production SIEM Analytics) or 'sqlite' (Development Hot Index)
ULPF_SEARCH_BACKEND=opensearch
ULPF_OPENSEARCH_URL=http://opensearch:9200
ULPF_OPENSEARCH_USERNAME=admin
ULPF_OPENSEARCH_PASSWORD=admin
ULPF_OPENSEARCH_INDEX_PREFIX=ulpf-events-v1
ULPF_OPENSEARCH_VERIFY_CERTS=false

# Local Storage Directory (Used for Data Lake Parquet and local fallbacks)
ULPF_BASE_DATA_DIR=data
ULPF_AIR_GAPPED=true

# Ingestion Network Binding & Ports
ULPF_API_HOST=0.0.0.0
ULPF_API_PORT=8000
ULPF_UDP_SYSLOG_PORT=5140
ULPF_TCP_SYSLOG_PORT=1514
ULPF_ENABLE_SYSLOG_LISTENERS=true

# Processing Queue & Workers
ULPF_QUEUE_BACKEND=memory
ULPF_WORKER_CONCURRENCY=4
ULPF_EVENT_DELIVERY_POLICY=at_least_once

# Ingestion Rate Limiting & Backpressure
ULPF_MAX_INGEST_PAYLOAD_BYTES=10485760
ULPF_MAX_INGEST_QUEUE_SIZE=10000
ULPF_RATE_LIMIT_INGEST_PER_MINUTE=60000
ULPF_RATE_LIMIT_AUTH_PER_MINUTE=60

# Data Retention Policies (Days)
ULPF_RAW_RETENTION_DAYS=365
ULPF_NORMALIZED_RETENTION_DAYS=90
ULPF_AUDIT_RETENTION_DAYS=730

# Logging & Observability
ULPF_LOG_LEVEL=INFO
ULPF_LOG_FORMAT=json
